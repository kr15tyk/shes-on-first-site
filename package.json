{
  "name": "shes-on-first",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "She's On First \u2014 women's baseball media site",
  "scripts": {
    "data:wpbl": "node scripts/fetch-wpbl-data.mjs",
    "stage:reviews": "node scripts/stage-private-reviews.mjs",
    "dev": "npm run stage:reviews && vite",
    "build": "tsc --noEmit && vite build && node scripts/build-static-routes.mjs",
    "build:with-reviews": "npm run stage:reviews && tsc --noEmit && vite build && INCLUDE_PRIVATE_REVIEWS=1 node scripts/build-static-routes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "preview": "vite preview",
    "data:refresh": "node scripts/refresh-wpbl.mjs",
    "test:wpbl": "node --test tests/wpbl-automation.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
